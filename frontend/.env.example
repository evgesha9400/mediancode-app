# Environment Configuration
# See ENVIRONMENTS.md for full environment strategy across all services.
#
# All client-exposed variables use the PUBLIC_ prefix (SvelteKit convention).

# =============================================================================
# Clerk Authentication
# =============================================================================
# Get from https://dashboard.clerk.com (use Development instance for local dev)
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend API URL
# Local development uses localhost (default if not set).
# For deployed environments, set in Vercel Dashboard per environment.
# PUBLIC_API_BASE_URL=http://localhost:8000/v1

# =============================================================================
# E2E Testing Configuration
# =============================================================================
# Required for: bun run test:e2e:crud
#
# Create a test user in your Clerk dev environment and add credentials here.
# These tests run against a real backend (local or hosted).

# Test user credentials (pre-created in Clerk dev environment)
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=

# Backend API URL for E2E tests
# Option 1: Local backend (recommended for development)
#   E2E_API_BASE_URL=http://localhost:8000/v1
# Option 2: Hosted dev backend
#   E2E_API_BASE_URL=https://api.dev.mediancode.com/v1
E2E_API_BASE_URL=http://localhost:8000/v1

# Clerk secret key (required for setup project - @clerk/testing token)
# Get from Clerk Dashboard > API Keys
CLERK_SECRET_KEY=

# E2E action delay (ms) - the single delay used after every page object action.
# Replaces all hardcoded timeouts. Controls speed of the entire test.
# Default: 300 (enough for animations/debounce)
# Observation: 1500-2000 (watch each step in --headed mode)
# Fast CI: 100
# E2E_ACTION_DELAY=300
